  <PropertyGroup>
    <!--
      Skip InfVerif / DPVerifierTask. On some WDK installs the x86 InfVerif.dll
      is missing and the task fails with HRESULT 0x8007007E. The driver is
      test-signed for VM use only, so package verification adds no value.
    -->
    <SkipPackageVerification>true</SkipPackageVerification>

    <!--
      inf2cat compares the stamped DriverVer date against the system clock.
      It defaults to UTC, so any build done after local midnight but before
      UTC midnight ("today local, yesterday UTC") fails with
      "DriverVer set to a date in the future (postdated DriverVer not allowed)".
      Forcing local-time comparison eliminates the race regardless of TZ
      offset. test-signed VM driver, so signing-strictness is unimportant.
    -->
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>

    <!--
      Test-sign with the WinternalTestCert generated by tools/new-test-cert.ps1.
      Searching CurrentUser\My by subject avoids needing an elevated build.
      If the cert isn't present the build still produces an unsigned .sys —
      callers can re-sign it later with signtool.
    -->
    <GenerateTestCertificate>false</GenerateTestCertificate>
    <SubjectName>WinternalTestCert</SubjectName>
    <CertificateStoreName>My</CertificateStoreName>
  </PropertyGroup>
