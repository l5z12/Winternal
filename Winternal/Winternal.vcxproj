  <!--
    Lua 5.4 sources compiled into the driver. Each is force-included with
    klua/klua_kernel.h so the io/string/locale macros redirect to our
    kernel shims. We exclude the file-loader and the math/os/loadlib
    modules (no fopen, no math.h, no LoadLibrary in kernel).
  -->
  <ItemGroup>
    <ClCompile Include="klua\*.c" Exclude="klua\klua_kernel.c">
      <CompileAs>CompileAsC</CompileAs>
      <ForcedIncludeFiles>klua_kernel.h</ForcedIncludeFiles>
      <PreprocessorDefinitions>LUAI_HARDSTACKTESTS;LUAI_HARDMEMTESTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4244;4267;4310;4324;4456;4459;4701;4702;4706;4204;4334</DisableSpecificWarnings>
      <SDLCheck>false</SDLCheck>
      <BufferSecurityCheck>false</BufferSecurityCheck>
